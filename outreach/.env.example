# Copy this to .env and fill in the values. The .env file is gitignored.

# OpenAI — used to draft personalized email bodies. You already have this from
# the main project; you can reuse the same key.
OPENAI_API_KEY=""

# Apollo.io — used to find recruiter work emails. Free tier: 50 credits/mo.
# Get at https://apolloapp.io → Settings → API
APOLLO_API_KEY=""

# Gmail — the account that actually sends the cold emails.
#   GMAIL_USER: your @gmail.com address
#   GMAIL_APP_PASSWORD: 16-character app password (NOT your normal Gmail
#     password). Generate at https://myaccount.google.com/apppasswords
#     after enabling 2-Step Verification.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Optional — used in the email signature.
SENDER_NAME="Shafay"
SENDER_TITLE="Solo dev, PurpleHire"
PRODUCT_URL="https://purplehire.vercel.app/demo"
